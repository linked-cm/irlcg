{
  "name": "@linked.cm/irlcg",
  "version": "0.1.1",
  "description": "Portable, standards-aligned ontology and base Shapes for in-real-life participation mechanics.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.2.2",
  "linkedPackage": true,
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/irlcg.git"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./lib/esm/package.js",
    "./lib/esm/ontology.js",
    "./lib/esm/shapes.js",
    "./lib/esm/ontologies/irlcg.register.js",
    "./lib/esm/shapes/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./ontology": {
      "types": "./lib/esm/ontology.d.ts",
      "import": "./lib/esm/ontology.js"
    },
    "./shapes": {
      "types": "./lib/esm/shapes.d.ts",
      "import": "./lib/esm/shapes.js"
    },
    "./shapes/index": {
      "types": "./lib/esm/shapes/index.d.ts",
      "import": "./lib/esm/shapes/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "import": "./lib/esm/package.js"
    }
  },
  "scripts": {
    "build": "npm exec linked build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@_linked/core": "^2.48.0",
    "@_linked/schema": "^1.9.2"
  },
  "devDependencies": {
    "@_linked/cli": "1.61.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/n3": "^1.26.6",
    "@types/node": "^20.12.7",
    "n3": "^2.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "linkedOntologies": {
    "irlcg": {
      "namespace": "https://linked.cm/ont/irlcg/",
      "data": [
        "irlcg.ttl"
      ]
    }
  }
}
