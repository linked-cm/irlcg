{
  "name": "@linked.cm/irlcg",
  "version": "0.1.1",
  "description": "Portable, standards-aligned ontology and base Shapes for in-real-life participation mechanics.",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "linkedPackage": true,
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/irlcg.git"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./lib/esm/package.js",
    "./lib/esm/ontology.js",
    "./lib/esm/shapes.js",
    "./lib/esm/ontologies/irlcg.register.js",
    "./lib/esm/shapes/*"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./ontology": {
      "types": "./lib/esm/ontology.d.ts",
      "import": "./lib/esm/ontology.js"
    },
    "./shapes": {
      "types": "./lib/esm/shapes.d.ts",
      "import": "./lib/esm/shapes.js"
    },
    "./shapes/index": {
      "types": "./lib/esm/shapes/index.d.ts",
      "import": "./lib/esm/shapes/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "import": "./lib/esm/package.js"
    }
  },
  "scripts": {
    "build": "npm exec linked build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@_linked/auth": "^1.2.4",
    "@_linked/core": "^2.25.0",
    "@_linked/input": "~1.0",
    "@_linked/mui-base": "~1.0",
    "@_linked/react": "^1.1.0",
    "@_linked/schema": "^1.1.4",
    "@_linked/server-utils": "~1.0",
    "@_linked/sioc": "1.x",
    "@_linked/xsd": "~1.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@linked.cm/profile": "0.1.0",
    "@mui/base": "5.0.0-beta.29",
    "@tolgee/react": "^5.16.2",
    "classnames": "^2.5.1",
    "formidable": "^3.5.4",
    "react-confetti": "^6.4.0",
    "react-select": "^5.8.0"
  },
  "devDependencies": {
    "@_linked/cli": "1.39.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^20.12.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
